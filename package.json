{
  "name": "apt-distances",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome check --write .",
    "lint": "biome ci --error-on-warnings .",
    "test": "svelte-kit sync && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.1",
    "@googlemaps/routing": "^3.2.0",
    "luxon": "^3.6.1"
  }
}
