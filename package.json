{
  "name": "apt-distances",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#tests/*": "./tests/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome check --write .",
    "lint": "biome ci --error-on-warnings .",
    "test": "svelte-kit sync && vitest run",
    "db:types": "node scripts/generate-db-types.ts && biome check --write src/lib/server/db/schema"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@electric-sql/pglite": "^0.6.0",
    "@lucide/svelte": "^1.80.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/svelte": "^5.4.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "cn": "^0.5.2",
    "jsdom": "^30.1.3",
    "kanel": "^4.0.6",
    "kanel-kysely": "^4.0.1",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "kysely": "^0.29.9",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "valibot": "^1.5.0"
  }
}
